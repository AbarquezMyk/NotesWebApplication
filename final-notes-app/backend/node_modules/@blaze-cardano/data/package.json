{
  "name": "@blaze-cardano/data",
  "version": "0.6.4",
  "description": "Plutus Data parsing and serialization",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@sinclair/typebox": "^0.34.28",
    "@blaze-cardano/core": "0.7.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "commander": "^12.1.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.3",
    "tsup": "^8.2.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "@blaze-cardano/eslint-config": "0.0.2",
    "@blaze-cardano/jest-config": "0.0.1",
    "@blaze-cardano/tsconfig": "0.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --watch --dts",
    "lint": "eslint .",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "test": "jest"
  }
}